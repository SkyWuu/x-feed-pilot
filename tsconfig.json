{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "/opt/homebrew/lib/node_modules/ts-node/node_modules/@types"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
